# Скопируйте в .env и измените значения при необходимости.

# Адрес и порт API/сервера.
# Для доступа с других устройств в локальной сети: HOST=0.0.0.0.
HOST=127.0.0.1
PORT=3001

# Файл базы SQLite. По умолчанию data/tracker.sqlite.
# DB_FILE=./data/tracker.sqlite

# Первый администратор создаётся только если в базе ещё нет ни одного администратора.
# Если пароль не задан, сервер сгенерирует его и покажет в консоли один раз.
INITIAL_ADMIN_LOGIN=admin
# INITIAL_ADMIN_PASSWORD=замените-на-длинный-пароль

# Для production за HTTPS включите Secure-cookie.
# COOKIE_SECURE=1

# Если сервер стоит за доверенным reverse proxy (nginx/Caddy), включите,
# чтобы корректно определялся IP для rate limit.
# TRUST_PROXY=1

# Уровень логов Fastify: fatal, error, warn, info, debug, trace.
LOG_LEVEL=warn

# Каталог для резервных копий (npm run backup). По умолчанию backups/.
# BACKUP_DIR=./backups
